# Provider is configured in src/constants/demoConfig.ts (default: openai)
# Set one key depending on which provider you use.

# OpenAI (default provider)
VITE_OPENAI_API_KEY=
VITE_OPENAI_IMAGE_MODEL=gpt-image-1

# Gemini (alternative provider)
VITE_GEMINI_API_KEY=
VITE_GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp

# Optional: enable reconstruction service (default: false)
VITE_ENABLE_TEETH_ML=false
VITE_TEETH_RECON_API_URL=http://localhost:5001
VITE_TEETH_DREAMER_API_URL=

# Optional: role label overrides (JSON object; used by shared roles util)
# VITE_ROLE_LABELS=
